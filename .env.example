# Deployment: suffix of the container names (gh-webhook-app-<env>, gh-webhook-db-<env>)
DEPLOY_ENV=prod

# General Settings
DEBUG=false
APP_NAME='Github Webhook Bot'
LOG_DIR=logs
# LOG_FORMAT: text | json
LOG_FORMAT=text
APP_PORT=8000
DB_PORT=5432

# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_DB=gh_webhook
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"
DATABASE_ECHO=false

# Telegram Bot Settings
BOT_TOKEN=your_bot_token_here
USE_WEBHOOK=false
WEBHOOK_URL=https://your-domain.com
WEBHOOK_SECRET=your_webhook_secret_here
WEBHOOK_PATH=/webhook
MASTER_CHAT_ID=123456789

# Observability (optional bearer token for /misc/metrics)
METRICS_TOKEN=

# Admin dashboard at /admin (HTTP Basic auth); leave ADMIN_PASSWORD empty to disable
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# FastAPI Server Settings
HOST=0.0.0.0
PORT=8000

# Gunicorn Worker Settings
WORKERS=4
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=50
LOG_LEVEL=info
GUNICORN_ACCESS_LOG=logs/gunicorn_access.log
GUNICORN_ERROR_LOG=logs/gunicorn_error.log

# GitHub Settings
GH_WEBHOOK_SECRET=your_github_webhook_secret_here
GH_WEBHOOK_URL=https://your-domain.com
GH_WEBHOOK_PATH=/webhook
REQUIRE_PAIRING_CODE=true
WEBHOOK_PROCESS_IN_BACKGROUND=true
# Inline actions (re-run failed jobs, approve/merge PRs); needs a token with actions + pull requests write access
GH_TOKEN=
GH_API_URL=https://api.github.com
# GH_MERGE_METHOD: merge | squash | rebase
GH_MERGE_METHOD=merge
